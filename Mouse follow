var ghost=createSprite(200,200)
ghost.setAnimation("ghost")

var x=0
var y=0

function draw() {
if (World.mouseX>ghost.x){x=x+2
}
if (World.mouseX<ghost.x){x=x-2
}
if (ghost.x>400){x=x-2
}
if (ghost.x<0){x=x+2
}
ghost.velocityX=x/.8

if (World.mouseY>ghost.y){y=y+2
}
if (World.mouseY<ghost.y){y=y-2
}

if (ghost.y>400){y=y-2
}
if (ghost.y<0){y=y+2
}
ghost.velocityY=y/.8

if (x>10){
  x=x-2}
  if (x<-10){
  x=x+2}
  if (y>10){
  y=y-2}
  if (y<-10){
  y=y+2}
  
background("white")
 drawSprites();
}
