//Update Stock
function updateStock() {
    tick++;
    mean = 0;
    if (point.y > 250) mean += randomNumber(-15, 0);
    else mean += randomNumber(-10, 10);
    if (point.y < 150) mean += randomNumber(0, 15);
    else mean += randomNumber(-10, 10); //stock variables//
    if (level == 1) {
        mean /= 10;
    }
    if (peak == 1) {
        mean -= randomNumber(1, 8);
    }
    if (crash == 1) {
        mean += randomNumber(1, 8);
    }
    if (overflow == 1) {
        mean += randomNumber(1, 8);
    }
    if (overflow2 == 1) {
        mean += randomNumber(1, 8);
    }
    if (underflow == 1) {
        mean -= randomNumber(1, 8);
    }
    if (underflow2 == 1) {
        mean -= randomNumber(1, 8);
    }
    if (median == 0) {
        mean += randomNumber(0, 2);
    }
    if (median == 1) {
        mean -= randomNumber(0, 2);
    }
    if (price >= 90) {
        price = 90;
        mean = 20;
    }
    if (price <= 1) {
        price = 1;
        mean = -20;
    }
    point.y += mean;
    price = Math.round(100 - ((point.y - 100) / 200) * 100); //price calculation
    mean = Math.max(-20, Math.min(20, mean));
    point.x += 25;
    points.push({
        x: point.x,
        y: point.y
    });
    if (point.x > 335) {
        for (var i = 0; i < points.length; i++) {
            points[i].x -= 25;
        }
        point.x -= 25;
        if (points[0].x < 130) {
            points.shift();
        }
    }
    countDown = frames;
    setTimeout(updateStock, stocktick);
}
updateStock();

