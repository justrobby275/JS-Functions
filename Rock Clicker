//FontSize Function Inspired by    https://stackoverflow.com/questions/6114300/shrinking-font-size-at-a-user-types-to-fit-in-an-input-using-javascript
function FontSize(textStr, startX, endX, baseSize, minSize) {
    var wMax = endX - startX;
    var size = baseSize; //Proportions
    var shrink = wMax / textWidth(textStr);
    if (shrink < 1) size = Math.max(minSize, size * shrink);
    textSize(size); // Wrap
    var words = textStr.split(" "),
        line = "",
        out = "";
    for (var i = 0; i < words.length; i++) {
        var test = line + (line ? " " : "") + words[i];
        if (textWidth(test) > wMax) {
            out += line + "\n";
            line = words[i];
        } else line = test;
    }
    out += line;
    return {
        text: out,
        size: size
    };
}

function formatNumber(num) { //chop off 1 zero and devide by 10 for the dec
    if (num >= 1000000000000000000) {
        return Math.floor(num / 100000000000000000) / 10 + "S";
    } else if (num >= 1000000000000000) {
        return Math.floor(num / 100000000000000) / 10 + "Q";
    } else if (num >= 1000000000000) {
        return Math.floor(num / 100000000000) / 10 + "T";
    } else if (num >= 1000000000) {
        return Math.floor(num / 100000000) / 10 + "B";
    } else if (num >= 1000000) {
        return Math.floor(num / 100000) / 10 + "M";
    } else if (num >= 1000) {
        return Math.floor(num / 100) / 10 + "K";
    } else {
        return num;
    }
}

